# Estudo+ — configuração do Supabase para Vercel
#
# Copie os valores correspondentes do arquivo .env para a Vercel.
# Nunca coloque uma chave Secret ou service_role neste arquivo.

# 1. Identificação do projeto
SUPABASE_PROJECT_ID=
VITE_SUPABASE_PROJECT_ID=

# 2. Endereço do projeto Supabase
SUPABASE_URL=
VITE_SUPABASE_URL=

# 3. Chave pública do projeto (Publishable)
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
