{
  "name": "@lovable.dev/mcp-js",
  "version": "0.22.2",
  "description": "Author MCP servers for Lovable apps. Declare tools with defineTool, register them in defineMcp, and a framework adapter (TanStack or Supabase Edge Functions) emits the route(s) at build time.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lovablelabs/lovable.git",
    "directory": "npm-packages/lovable-mcp-js"
  },
  "homepage": "https://github.com/lovablelabs/lovable/tree/main/npm-packages/lovable-mcp-js#readme",
  "bugs": {
    "url": "https://github.com/lovablelabs/lovable/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./protocols/mcp": {
      "import": {
        "types": "./dist/protocols/mcp/index.d.ts",
        "default": "./dist/protocols/mcp/index.js"
      },
      "require": {
        "types": "./dist/protocols/mcp/index.d.cts",
        "default": "./dist/protocols/mcp/index.cjs"
      }
    },
    "./protocols/oauth-metadata": {
      "import": {
        "types": "./dist/protocols/oauth-metadata.d.ts",
        "default": "./dist/protocols/oauth-metadata.js"
      },
      "require": {
        "types": "./dist/protocols/oauth-metadata.d.cts",
        "default": "./dist/protocols/oauth-metadata.cjs"
      }
    },
    "./protocols/rest": {
      "import": {
        "types": "./dist/protocols/rest/index.d.ts",
        "default": "./dist/protocols/rest/index.js"
      },
      "require": {
        "types": "./dist/protocols/rest/index.d.cts",
        "default": "./dist/protocols/rest/index.cjs"
      }
    },
    "./stacks/tanstack": {
      "import": {
        "types": "./dist/stacks/tanstack/index.d.ts",
        "default": "./dist/stacks/tanstack/index.js"
      },
      "require": {
        "types": "./dist/stacks/tanstack/index.d.cts",
        "default": "./dist/stacks/tanstack/index.cjs"
      }
    },
    "./stacks/tanstack/vite": {
      "import": {
        "types": "./dist/stacks/tanstack/vite.d.ts",
        "default": "./dist/stacks/tanstack/vite.js"
      },
      "require": {
        "types": "./dist/stacks/tanstack/vite.d.cts",
        "default": "./dist/stacks/tanstack/vite.cjs"
      }
    },
    "./stacks/supabase": {
      "import": {
        "types": "./dist/stacks/supabase/index.d.ts",
        "default": "./dist/stacks/supabase/index.js"
      },
      "require": {
        "types": "./dist/stacks/supabase/index.d.cts",
        "default": "./dist/stacks/supabase/index.cjs"
      }
    },
    "./stacks/supabase/vite": {
      "import": {
        "types": "./dist/stacks/supabase/vite.d.ts",
        "default": "./dist/stacks/supabase/vite.js"
      },
      "require": {
        "types": "./dist/stacks/supabase/vite.d.cts",
        "default": "./dist/stacks/supabase/vite.cjs"
      }
    }
  },
  "bin": {
    "lovable-mcp-extract-manifest": "./dist/cli/extract-manifest.cjs"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tanstack",
    "vite",
    "lovable"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.28.0",
    "esbuild": "^0.27.0",
    "jose": "^6.2.2"
  },
  "peerDependencies": {
    "vite": ">=5.0.0 <9.0.0",
    "zod": ">=3.23.0"
  },
  "devDependencies": {
    "@types/node": "22.13.13",
    "rimraf": "^5.0.0",
    "tsdown": "^0.22.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.5",
    "zod": "^4.1.13"
  },
  "scripts": {
    "build": "tsdown",
    "check:package": "tmp=$(mktemp -d) && pnpm pack --out \"$tmp/pkg.tgz\" && tar -xzf \"$tmp/pkg.tgz\" -C \"$tmp\" && publint \"$tmp/package\" --strict && attw \"$tmp/pkg.tgz\"",
    "dev": "tsdown --watch",
    "typecheck": "tsgo --noEmit",
    "format": "oxfmt --write src/ tests/",
    "format:check": "oxfmt --check src/ tests/",
    "lint": "oxfmt --check src/ tests/ && oxlint -c ../../oxlint.config.ts src/ tests/",
    "lint:fix": "oxfmt --write src/ tests/ && oxlint -c ../../oxlint.config.ts --fix src/ tests/",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "example:tanstack:install": "bun link && cd example/tanstack && bun install && bun link @lovable.dev/mcp-js",
    "example:tanstack:dev": "cd example/tanstack && bun --bun run dev",
    "example:tanstack:build": "cd example/tanstack && bun --bun run build",
    "example:tanstack:oauth:install": "bun link && cd example/tanstack-supabase-oauth && bun install && bun link @lovable.dev/mcp-js",
    "example:tanstack:oauth:dev": "cd example/tanstack-supabase-oauth && bun --bun run dev",
    "example:tanstack:oauth:build": "cd example/tanstack-supabase-oauth && bun --bun run build",
    "example:tanstack:oauth:smoke": "node tests/integration/oauth-smoke.mjs",
    "example:supabase:install": "bun link && cd example/supabase && bun install && bun link @lovable.dev/mcp-js",
    "example:supabase:dev": "cd example/supabase && bun --bun run dev",
    "example:supabase:build": "cd example/supabase && bun --bun run build",
    "test:integration:tanstack": "npm run build && npm run example:tanstack:install && vitest run --project integration",
    "test:integration:tanstack:oauth": "npm run build && npm run example:tanstack:oauth:install && vitest run --project integration-oauth",
    "clean": "rimraf dist",
    "pack:local": "npm run build && npm pack --pack-destination /tmp"
  }
}